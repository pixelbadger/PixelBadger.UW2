{
  "name": "pixelbadger-uw2",
  "private": true,
  "version": "0.2.0",
  "description": "Ultima Underworld II engine for the web: reads the original game data in the browser and plays it with WebGL2.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.mjs",
    "test:data": "vitest run --config vitest.data.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0"
  }
}
